-- =============================================================================
-- 019_add_cms_settings_tables.sql
-- Add CMS Settings tables for landing page customization system
--
-- This migration creates the database schema for the landing page customization
-- system, enabling administrators to dynamically customize landing page styling,
-- content, and component visibility without requiring code changes.
--
-- Tables created:
--   1. cms_settings (main configuration store - one record per tenant)
--   2. cms_settings_versions (version history for rollback capability)
--   3. cms_audit_log (audit trail for compliance and troubleshooting)
--   4. theme_presets (pre-configured theme templates)
--
-- Key Features:
--   - Strict tenant isolation with UNIQUE constraint on tenant_id
--   - JSONB structure for flexible customization storage
--   - Version tracking for rollback functionality
--   - Comprehensive audit logging
--   - Foreign key constraints for referential integrity
--   - Performance indexes for tenant-based queries
--
-- Migration Strategy:
--   1. Create cms_settings table (main store)
--   2. Create cms_settings_versions table (version history)
--   3. Create cms_audit_log table (audit trail)
--   4. Create theme_presets table (preset templates)
--   5. Create indexes for performance optimization
--   6. Add update triggers for timestamp management
--   7. Migration is idempotent (safe to run multiple times)
--
-- Mapped Requirements:
--   - Requirement 8.1: Database storage of customizations
--   - Requirement 8.2: Metadata storage (created_at, updated_at, updated_by_admin_id)
--   - Requirement 2.1: Tenant isolation with tenant_id foreign key
--   - Requirement 13: Configuration versioning and rollback
--   - Requirement 15: Customization audit trail
-- =============================================================================

BEGIN;

-- =============================================================================
-- 1. CMS SETTINGS TABLE (Main Configuration Store)
-- =============================================================================

-- Primary table storing the active customization configuration for each tenant
-- One record per tenant with UNIQUE constraint on tenant_id
CREATE TABLE IF NOT EXISTS cms_settings (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  tenant_id UUID NOT NULL UNIQUE,
  
  -- JSONB structure containing all customization data
  settings_data JSONB NOT NULL DEFAULT '{
    "colors": {
      "primary": "#3B82F6",
      "secondary": "#10B981",
      "accent": "#F59E0B",
      "background": "#FFFFFF",
      "text": "#1F2937",
      "borders": "#E5E7EB"
    },
    "typography": {
      "headings": {
        "fontFamily": "Poppins",
        "fontSize": {
          "h1": 48,
          "h2": 36,
          "h3": 28
        },
        "fontWeight": 700,
        "lineHeight": 1.2
      },
      "body": {
        "fontFamily": "Inter",
        "fontSize": 16,
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    },
    "layout": {
      "containerWidth": "1200px",
      "containerLayout": "centered",
      "padding": {
        "heroSection": 40,
        "contentAreas": 32,
        "footer": 24
      },
      "margins": {
        "sectionSpacing": 48,
        "elementSpacing": 16
      },
      "gaps": {
        "grid": 24,
        "flex": 16
      }
    },
    "components": {
      "navigation": {
        "enabled": true,
        "style": "light"
      },
      "hero": {
        "enabled": true,
        "backgroundImage": "url(...)",
        "overlayColor": "rgba(0,0,0,0.3)",
        "height": "500px"
      },
      "features": {
        "enabled": true,
        "layout": "grid",
        "columns": 3
      },
      "testimonials": {
        "enabled": true,
        "displayCount": 3
      },
      "ctaSection": {
        "enabled": true,
        "style": "button"
      },
      "contact": {
        "enabled": true,
        "formFields": ["email", "phone", "message"]
      },
      "footer": {
        "enabled": true,
        "linkColumns": 4
      }
    },
    "content": {
      "hero": {
        "heading": "Welcome to Our Platform",
        "subheading": "Build amazing things",
        "ctaText": "Get Started"
      },
      "missionVision": {
        "title": "Our Mission",
        "description": "To empower businesses...",
        "vision": "To be the leading..."
      },
      "features": [
        {
          "title": "Feature 1",
          "description": "Description...",
          "icon": "icon-name"
        }
      ],
      "testimonials": [
        {
          "text": "Great product!",
          "author": "John Doe",
          "image": "url(...)"
        }
      ],
      "contact": {
        "email": "contact@example.com",
        "phone": "+1-555-000-0000",
        "address": "123 Main St",
        "socialLinks": {
          "twitter": "https://twitter.com/...",
          "linkedin": "https://linkedin.com/..."
        }
      }
    }
  }',
  
  -- Metadata columns
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_by_admin_id UUID,
  
  -- Foreign key constraints
  CONSTRAINT fk_cms_settings_tenant FOREIGN KEY (tenant_id) 
    REFERENCES tenants(id) ON DELETE CASCADE,
  CONSTRAINT fk_cms_settings_admin FOREIGN KEY (updated_by_admin_id) 
    REFERENCES users(id) ON DELETE SET NULL
);

-- Index for fast tenant lookups (Requirement 2 - Tenant Isolation)
CREATE INDEX IF NOT EXISTS idx_cms_settings_tenant_id 
  ON cms_settings(tenant_id);

-- Trigger to automatically update updated_at timestamp on modification
DROP TRIGGER IF EXISTS trigger_cms_settings_updated_at ON cms_settings;
CREATE TRIGGER trigger_cms_settings_updated_at
  BEFORE UPDATE ON cms_settings
  FOR EACH ROW
  EXECUTE FUNCTION trigger_set_updated_at();


-- =============================================================================
-- 2. CMS SETTINGS VERSIONS TABLE (Version History for Rollback)
-- =============================================================================

-- Tracks configuration history for rollback and versioning (Requirement 13)
CREATE TABLE IF NOT EXISTS cms_settings_versions (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  cms_settings_id UUID NOT NULL,
  tenant_id UUID NOT NULL,
  
  -- Snapshot of the configuration at this version
  settings_data JSONB NOT NULL,
  
  -- Version tracking
  version_number INTEGER NOT NULL,
  change_summary VARCHAR(255),
  
  -- Metadata
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  created_by_admin_id UUID,
  
  -- Foreign key constraints
  CONSTRAINT fk_cms_versions_cms_settings FOREIGN KEY (cms_settings_id) 
    REFERENCES cms_settings(id) ON DELETE CASCADE,
  CONSTRAINT fk_cms_versions_tenant FOREIGN KEY (tenant_id) 
    REFERENCES tenants(id) ON DELETE CASCADE,
  CONSTRAINT fk_cms_versions_admin FOREIGN KEY (created_by_admin_id) 
    REFERENCES users(id) ON DELETE SET NULL,
  
  -- Unique constraint to prevent duplicate versions
  CONSTRAINT unique_cms_version UNIQUE(cms_settings_id, version_number)
);

-- Indexes for efficient version queries
CREATE INDEX IF NOT EXISTS idx_cms_versions_tenant_id 
  ON cms_settings_versions(tenant_id);

CREATE INDEX IF NOT EXISTS idx_cms_versions_cms_settings_id 
  ON cms_settings_versions(cms_settings_id);

CREATE INDEX IF NOT EXISTS idx_cms_versions_created_at 
  ON cms_settings_versions(created_at DESC);


-- =============================================================================
-- 3. CMS AUDIT LOG TABLE (Audit Trail for Compliance)
-- =============================================================================

-- Tracks all customization changes for compliance and troubleshooting (Requirement 15)
CREATE TABLE IF NOT EXISTS cms_audit_log (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  tenant_id UUID NOT NULL,
  admin_id UUID,
  
  -- Action type: create, update, delete, import, rollback, apply_preset, export
  action VARCHAR(50) NOT NULL
    CHECK (action IN ('create', 'update', 'delete', 'import', 'rollback', 'apply_preset', 'export')),
  
  -- Resource type: cms_settings, theme_preset, etc.
  resource_type VARCHAR(50),
  
  -- Resource ID for the affected resource
  resource_id UUID,
  
  -- JSON object containing what changed
  -- Example: {"colors": {"primary": {"old": "#3B82F6", "new": "#FF0000"}}}
  changes JSONB,
  
  -- Optional error message if operation failed
  error_message TEXT,
  
  -- Optional IP address for tracking
  ip_address VARCHAR(45),
  
  -- Optional user agent string
  user_agent VARCHAR(255),
  
  -- Timestamp of the change
  timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  
  -- Foreign key constraints
  CONSTRAINT fk_cms_audit_tenant FOREIGN KEY (tenant_id) 
    REFERENCES tenants(id) ON DELETE CASCADE,
  CONSTRAINT fk_cms_audit_admin FOREIGN KEY (admin_id) 
    REFERENCES users(id) ON DELETE SET NULL
);

-- Indexes for efficient audit log queries (Requirement 15.2, 2.10)
CREATE INDEX IF NOT EXISTS idx_cms_audit_tenant_id 
  ON cms_audit_log(tenant_id);

CREATE INDEX IF NOT EXISTS idx_cms_audit_admin_id 
  ON cms_audit_log(admin_id);

CREATE INDEX IF NOT EXISTS idx_cms_audit_timestamp 
  ON cms_audit_log(timestamp DESC);

CREATE INDEX IF NOT EXISTS idx_cms_audit_action 
  ON cms_audit_log(action);

-- Composite index for efficient tenant-scoped range queries (Requirement 15.2, 2.10)
CREATE INDEX IF NOT EXISTS idx_cms_audit_tenant_timestamp 
  ON cms_audit_log(tenant_id, timestamp DESC);


-- =============================================================================
-- 4. THEME PRESETS TABLE (Pre-Configured Theme Templates)
-- =============================================================================

-- Pre-configured theme templates for quick setup (Requirement 10)
-- These are global presets, each tenant applies their own copy
CREATE TABLE IF NOT EXISTS theme_presets (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  
  -- Preset metadata
  name VARCHAR(255) NOT NULL,
  description TEXT,
  category VARCHAR(100), -- e.g., "modern", "corporate", "creative", "bold", "startup", "luxury"
  
  -- Preset configuration data (same structure as cms_settings.settings_data)
  preset_data JSONB NOT NULL,
  
  -- Enable/disable preset availability (Requirement 10.2)
  is_active BOOLEAN DEFAULT true,
  
  -- Metadata
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  
  -- Ensure preset names are unique (Requirement 10.2)
  CONSTRAINT unique_preset_name UNIQUE(name)
);

-- Index for efficient preset queries by active status (Requirement 10.2)
CREATE INDEX IF NOT EXISTS idx_theme_presets_is_active 
  ON theme_presets(is_active);

-- Index for filtering by category (Requirement 10.2)
CREATE INDEX IF NOT EXISTS idx_theme_presets_category 
  ON theme_presets(category);

CREATE INDEX IF NOT EXISTS idx_theme_presets_created_at 
  ON theme_presets(created_at DESC);

-- Trigger to automatically update updated_at timestamp on modification
DROP TRIGGER IF EXISTS trigger_theme_presets_updated_at ON theme_presets;
CREATE TRIGGER trigger_theme_presets_updated_at
  BEFORE UPDATE ON theme_presets
  FOR EACH ROW
  EXECUTE FUNCTION trigger_set_updated_at();


