-- =============================================================================
-- 5. FUNCTION: Populate initial cms_settings for existing tenants
-- =============================================================================

-- Helper function to initialize cms_settings for existing tenants
-- This allows the migration to be run on existing databases with data
CREATE OR REPLACE FUNCTION initialize_cms_settings_for_existing_tenants()
RETURNS void AS $$
BEGIN
  -- Insert cms_settings records for any tenants that don't already have one
  INSERT INTO cms_settings (tenant_id)
  SELECT id FROM tenants
  WHERE id NOT IN (SELECT tenant_id FROM cms_settings)
  ON CONFLICT (tenant_id) DO NOTHING;
END;
$$ LANGUAGE plpgsql;

-- Call the function to ensure all existing tenants have cms_settings records
SELECT initialize_cms_settings_for_existing_tenants();


-- =============================================================================
-- 6. VERIFICATION: Check that all tables and constraints are created
-- =============================================================================

-- Verify cms_audit_log table exists with required columns
DO $$
BEGIN
  ASSERT EXISTS (
    SELECT 1 FROM information_schema.tables 
    WHERE table_name = 'cms_audit_log'
  ), 'cms_audit_log table not found';
  
  ASSERT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_name = 'cms_audit_log' AND column_name = 'tenant_id'
  ), 'cms_audit_log missing tenant_id column';
  
  RAISE NOTICE 'Verification: cms_audit_log table created successfully';
END $$;

-- Verify theme_presets table exists with required columns
DO $$
BEGIN
  ASSERT EXISTS (
    SELECT 1 FROM information_schema.tables 
    WHERE table_name = 'theme_presets'
  ), 'theme_presets table not found';
  
  ASSERT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_name = 'theme_presets' AND column_name = 'is_active'
  ), 'theme_presets missing is_active column';
  
  RAISE NOTICE 'Verification: theme_presets table created successfully';
END $$;

-- Verify default presets are populated
DO $$
DECLARE
  preset_count INTEGER;
BEGIN
  SELECT COUNT(*) INTO preset_count FROM theme_presets WHERE is_active = true;
  
  ASSERT preset_count >= 6, 
    'Expected at least 6 active default presets, found ' || preset_count;
  
  RAISE NOTICE 'Verification: % active theme presets loaded successfully', preset_count;
END $$;
